# Required
OPENAI_API_KEY=sk-...

# Optional: leave empty to use the OpenAI Agents SDK default model
OPENAI_MODEL=
# Optional: a smaller, faster model for the travel-scope guardrail (defaults to OPENAI_MODEL)
GUARDRAIL_MODEL=

AGENT_HOST=127.0.0.1
AGENT_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
